# Estas variables las pone Vercel automáticamente cuando conectás los stores
# de Upstash y Blob al proyecto (ver README). Para desarrollo local, bajalas
# con `vercel env pull .env.local` en vez de copiarlas a mano.

# Upstash Redis (registro de enlaces) — las agrega la integración de Marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (guardado de los .docx generados) — la agrega el store de Blob
BLOB_READ_WRITE_TOKEN=

# Elegido por vos — protege /api/lista y /api/descargar
ADMIN_SECRET=
